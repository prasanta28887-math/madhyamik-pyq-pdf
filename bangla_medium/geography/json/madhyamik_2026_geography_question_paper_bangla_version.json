                "তুঙ্গভদ্রা পরিকল্পনা"
              ]
            },
            {
              "label": "১.১১",
              "text": "ভারতে শুষ্ক গ্রীষ্মকালে যে ফসলের চাষ করা হয় তাকে বলে —",
              "options": [
                "খারিফ ফসল",
                "রবি ফসল",
                "বাগিচা ফসল",
                "জায়িদ ফসল"
              ]
            },
            {
              "label": "১.১২",
              "text": "ভারতের ভারী ইঞ্জিনিয়ারিং শিল্পের একটি উদাহরণ হ'ল —",
              "options": [
                "বৈদ্যুতিন শিল্প",
                "রেলইঞ্জিন শিল্প",
                "বস্ত্রশিল্প",
                "তথ্যপ্রযুক্তি শিল্প"
              ]
            },
            {
              "label": "১.১৩",
              "text": "ছত্রপতি শিবাজী আন্তর্জাতিক বিমানবন্দর অবস্থিত —",
              "options": [
                "মুম্বাইতে",
                "চেন্নাইতে",
