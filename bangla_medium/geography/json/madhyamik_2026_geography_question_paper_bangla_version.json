          "subMCQs": [
            {
              "label": "১.১",
              "text": "বহির্জাত শক্তির মূল উৎস হ'ল —",
              "options": [
                "পারমাণবিক শক্তি",
                "সৌর শক্তি",
                "তেজস্ক্রিয় শক্তি",
                "স্থিতিশীল শক্তি"
              ]
            },
            {
              "label": "১.২",
              "text": "পার্বত্য হিমবাহের পৃষ্ঠদেশে সৃষ্ট গভীর ফাটলগুলিকে বলে —",
              "options": [
                "ক্রেভাস",
                "সার্ক",
                "বার্গশ্রুন্ড",
                "নুনাটাক"
              ]
            },
            {
              "label": "১.৩",
              "text": "হেটেরোস্ফিয়ারের প্রথম উপস্তরটি হ'ল —",
              "options": [
                "পারমাণবিক হাইড্রোজেন স্তর",
                "পারমাণবিক হিলিয়াম স্তর",
                "আণবিক নাইট্রোজেন স্তর",
                "পারমাণবিক অক্সিজেন স্তর"
              ]
            },
            {
              "label": "১.৪",
              "text": "আল্পস পর্বতের উত্তর ঢালে যে স্থানীয় বায়ুপ্রবাহের ফলে বরফ গলে যায়, তা হ'ল —",
              "options": [
                "বোরা",
                "চিনুক",
                "খামসিন",
                "ফন"
              ]
            },
            {
              "label": "১.৫",
              "text": "'শৈবাল সাগর' দেখা যায় —",
              "options": [
                "আটলান্টিক মহাসাগরে",
                "ভারত মহাসাগরে",
                "সুমেরু মহাসাগরে",
                "কুমেরু মহাসাগরে"
              ]
            },
            {
              "label": "১.৬",
              "text": "পৃথিবীর উপর চাঁদ ও সূর্যের মহাকর্ষীয় আকর্ষণের কারণে সমুদ্র জলতলের নিয়মিত উত্থান ও পতন-কে বলা হয় —",
              "options": [
                "সুনামি",
                "সমুদ্রতরঙ্গ",
                "সমুদ্রস্রোত",
                "জোয়ারভাটা"
              ]
            },
            {
              "label": "১.৭",
              "text": "বর্জ্য ব্যবস্থাপনায় নিম্নলিখিতটি 3R এর অন্তর্ভুক্ত নয় —",
              "options": [
                "পরিমাণগত হ্রাস",
                "পুনর্বিন্যাস",
                "পুনর্ব্যবহার",
                "পুনর্নবীকরণ"
              ]
            },
            {
              "label": "১.৮",
              "text": "অন্ধ্রপ্রদেশের বর্তমান রাজধানীর নাম হ'ল —",
              "options": [
                "হায়দ্রাবাদ",
                "সেকেন্দ্রাবাদ",
                "অমরাবতী",
                "বিজয়ওয়াড়া"
              ]
            },
            {
              "label": "১.۹",
              "text": "কাশ্মীরে অবস্থিত হিমালয়ের পর্বতমালাটি হ'ল —",
              "options": [
                "জাস্কার",
                "ধৌলাধর",
                "নাগটিব্বা",
                "সিঙ্গালিলা"
              ]
            },
            {
              "label": "১.১০",
              "text": "স্বাধীন ভারতের প্রথম বহুমুখী নদী পরিকল্পনা হ'ল —",
              "options": [
                "ভাকরা-নাঙ্গাল পরিকল্পনা",
                "হিরাকুদ পরিকল্পনা",
